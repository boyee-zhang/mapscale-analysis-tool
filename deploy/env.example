# Copy to .env NEXT TO docker-compose.deploy.yml on the target machine, then edit.
#   cp deploy/env.example .env
#
# Nothing here is read by the containers automatically — docker-compose.deploy.yml names
# each variable explicitly, so a typo is a missing value rather than a silent default.

# ── Postgres ────────────────────────────────────────────────────────────────
# Only used to build DATABASE_URL below and to initialise the volume. Changing them
# AFTER the first start does nothing: initdb has already run.
POSTGRES_USER=mapscale
POSTGRES_PASSWORD=mapscale
POSTGRES_DB=mapscale

# ── Published ports on the host ─────────────────────────────────────────────
# Pick anything free. 8088 rather than 80 so the bundle does not need root and does not
# collide with whatever already listens on 80.
WEB_PORT=8088
API_PORT=8000
PG_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Only used with --profile ors.
ORS_PORT=8080

# ── Routing: pick ONE of the three ──────────────────────────────────────────
# 1) Public OpenRouteService. Needs a free key from openrouteservice.org/dev/#/signup.
#    The quota is 50 requests/day/ENDPOINT — enough to click around, not enough to demo
#    for an hour, and /pois spends one isochrone per call server-side.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org/v2
#
# 2) Self-hosted, in this same stack. Uncomment the line below, put an .osm.pbf extract
#    in ./data/ (see ORS_EXTRACT), and start it with --profile ors. No key, no quota, and
#    foot-walking actually works. Costs ~4 GB of RAM while it builds and ~3-4 minutes for
#    a province-sized extract.
# ORS_BASE_URL=http://ors:8082/ors/v2
#
# 3) Leave ORS_BASE_URL at the public default with no key: every isochrone fails and
#    /pois falls back to a geodesic circle. The app still runs; the catchment is a lie.

# Which extract the ors service builds from. The bundle ships noord-holland (181 MB);
# netherlands-latest.osm.pbf (1.3 GB) needs 10-13 GB of JVM heap to build and was
# measured as not fitting an 8 GB Docker VM.
ORS_EXTRACT=noord-holland-latest.osm.pbf

# JVM max heap for the graph build. 4g was measured as the right figure for a
# province-sized extract (peak heap 2.03 GB, peak container RSS 2987 MiB over three
# profiles); the headroom is what absorbs a larger one. Lower it only if the machine
# cannot spare it, and expect the build to fail rather than slow down.
ORS_XMX=4g

# ── Backend tuning ──────────────────────────────────────────────────────────
# asyncpg pool size, PER PROCESS. The api service runs one uvicorn worker on purpose: N
# workers would open N x this many connections against a server whose max_connections is
# the default 100. Raise both together or neither.
DB_POOL_MAX_SIZE=10

# ── Other upstreams (all optional) ──────────────────────────────────────────
# Traffic flow tiles + incidents. Without it, the Traffic toggle returns an error; the
# rest of the map is unaffected.
TOMTOM_API_KEY=

# The AI panel talks to a separate Vercel deployment through nginx, so no key is needed
# here. This one is only for scripts that call DeepSeek directly.
DEEPSEEK_API_KEY=

# Address search. Unset = /search skips Elasticsearch and degrades to PDOK -> Nominatim,
# which is what this project actually runs on; the ES volume was never populated.
ES_URL=

# Redis is gone (the Upstash instance is NXDOMAIN). Left here as a reminder that these
# being unset is a deliberate state, not an oversight: kv_get short-circuits before any
# network call, which is the same result the failing path produced, minus the cost.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
